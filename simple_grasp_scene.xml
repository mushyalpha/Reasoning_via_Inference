<mujoco model="simple_grasp">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>
  
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.9 0.9 0.9 1"/>
    
    <!-- Table -->
    <body name="table" pos="0.5 0 0.2">
      <geom type="box" size="0.3 0.4 0.2" rgba="0.6 0.4 0.2 1"/>
    </body>
    
    <!-- Target object (graspable cylinder/cup) -->
    <body name="target_object" pos="0.5 0 0.45">
      <freejoint/>
      <geom type="cylinder" size="0.03 0.05" rgba="0.1 0.5 0.8 1" mass="0.1"/>
      <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
    </body>
    
    <!-- Simple Panda arm (using boxes as approximate geometry) -->
    <body name="panda_link0" pos="0 0 0">
      <geom type="box" size="0.08 0.08 0.165" rgba="0.95 0.95 0.95 1"/>
      
      <body name="panda_link1" pos="0 0 0.333">
        <joint name="panda_joint1" type="hinge" axis="0 0 1" range="-2.8973 2.8973" damping="1"/>
        <geom type="cylinder" size="0.06 0.08" rgba="0.95 0.95 0.95 1"/>
        
        <body name="panda_link2" pos="0 0 0">
          <joint name="panda_joint2" type="hinge" axis="0 0 1" range="-1.7628 1.7628" damping="1"/>
          <geom type="box" size="0.05 0.05 0.1" rgba="0.95 0.95 0.95 1"/>
          
          <body name="panda_link3" pos="0 0 0.316">
            <joint name="panda_joint3" type="hinge" axis="0 0 1" range="-2.8973 2.8973" damping="1"/>
            <geom type="cylinder" size="0.06 0.1" rgba="0.95 0.95 0.95 1"/>
            
            <body name="panda_link4" pos="0.0825 0 0">
              <joint name="panda_joint4" type="hinge" axis="0 0 1" range="-3.0718 -0.0698" damping="1"/>
              <geom type="box" size="0.04 0.04 0.15" rgba="0.95 0.95 0.95 1"/>
              
              <body name="panda_link5" pos="-0.0825 0 0.384">
                <joint name="panda_joint5" type="hinge" axis="0 0 1" range="-2.8973 2.8973" damping="1"/>
                <geom type="cylinder" size="0.05 0.08" rgba="0.95 0.95 0.95 1"/>
                
                <body name="panda_link6" pos="0 0 0">
                  <joint name="panda_joint6" type="hinge" axis="0 0 1" range="-0.0175 3.7525" damping="1"/>
                  <geom type="box" size="0.04 0.04 0.05" rgba="0.95 0.95 0.95 1"/>
                  
                  <body name="panda_link7" pos="0.088 0 0">
                    <joint name="panda_joint7" type="hinge" axis="0 0 1" range="-2.8973 2.8973" damping="1"/>
                    <geom type="cylinder" size="0.04 0.08" rgba="0.95 0.95 0.95 1"/>
                    
                    <!-- End effector / gripper -->
                    <body name="panda_hand" pos="0 0 0.107">
                      <geom type="box" size="0.04 0.04 0.04" rgba="0.7 0.7 0.7 1"/>
                      <site name="ee_site" pos="0 0 0.05"/>
                      
                      <!-- Left finger -->
                      <body name="left_finger" pos="0 0.02 0.05">
                        <joint name="finger_joint1" type="slide" axis="0 1 0" range="0 0.04" damping="0.5"/>
                        <geom type="box" size="0.01 0.005 0.03" rgba="0.9 0.9 0.9 1"/>
                      </body>
                      
                      <!-- Right finger -->
                      <body name="right_finger" pos="0 -0.02 0.05">
                        <joint name="finger_joint2" type="slide" axis="0 -1 0" range="0 0.04" damping="0.5"/>
                        <geom type="box" size="0.01 0.005 0.03" rgba="0.9 0.9 0.9 1"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    
    <!-- Perception camera -->
    <body name="perception_camera_body" pos="0.5 -0.6 1.0">
      <camera name="perception_camera" pos="0 0 0" quat="0.924 0.383 0 0" fovy="45"/>
      <geom type="box" size="0.02 0.04 0.02" rgba="0.2 0.8 0.2 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  
  <actuator>
    <position name="panda_actuator1" joint="panda_joint1" kp="500"/>
    <position name="panda_actuator2" joint="panda_joint2" kp="500"/>
    <position name="panda_actuator3" joint="panda_joint3" kp="500"/>
    <position name="panda_actuator4" joint="panda_joint4" kp="500"/>
    <position name="panda_actuator5" joint="panda_joint5" kp="500"/>
    <position name="panda_actuator6" joint="panda_joint6" kp="500"/>
    <position name="panda_actuator7" joint="panda_joint7" kp="500"/>
    <position name="finger_actuator1" joint="finger_joint1" kp="100"/>
    <position name="finger_actuator2" joint="finger_joint2" kp="100"/>
  </actuator>
</mujoco>
